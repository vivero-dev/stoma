{
  "name": "stoma-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter '!@vivero/stoma-docs' run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter '!@vivero/stoma-docs' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "node scripts/publish.mjs",
    "changeset:dry-run": "node scripts/publish.mjs --dry-run",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --no-errors-on-unmatched"
  }
}
